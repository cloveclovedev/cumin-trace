@startuml overview
title Packages of cumin-trace
skinparam shadowing false
skinparam componentStyle rectangle

package "product repository" {
  file ".cumin-trace.toml" as toml
  file "docs/ja/requirements/**/*.md" as docs
  folder "site/\nAstro + Starlight (not implemented)" as site #LightYellow
}

package "cumin-trace" {
  [cmd/cumin-trace\nchoose the command] as cmd
  [internal/check\nformat check] as check
  [internal/requirement\nread requirements (shared)] as requirement
  [internal/core\nread settings] as core
  [internal/export\nwrite requirements as JSON] as export
  [internal/scaffold\nwrite the templates (init)] as scaffold
  [templates\nembedded text (top level)] as templates
  [templates/site\nsite template (not implemented)] as tsite #LightYellow
  [internal/trace\ntrace requirements to issues] as trace
  [internal/platform\nread GitHub] as platform
}

cloud "GitHub GraphQL API" as api

cmd --> check : run
cmd --> export : run
cmd --> scaffold : run
cmd --> trace : run
export --> check : format check
export --> requirement : read requirements
export --> core : read settings
trace --> check : format check
trace --> requirement : read requirements
trace --> core : read settings
trace --> export : requirement object
trace --> platform : read issues
platform --> api : reads
scaffold --> templates : reads
scaffold --> core : name rule, paths
scaffold --> toml : writes
scaffold --> docs : writes
scaffold --> tsite : reads
scaffold --> site : writes
site --> toml : reads
site --> docs : reads (build)
check --> requirement : read requirements
check --> core : read settings
core --> toml : reads
requirement --> docs : reads

legend right
  each box in cumin-trace is one Go package
  arrow = imports, reads, or writes a file
endlegend
@enduml
