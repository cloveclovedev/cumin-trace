@startuml trace-progress
skinparam shadowing false

start
if (an open requirement issue\nnames the ID?) then (yes)
  #FFF3E0:in progress;
else (no)
  if (a requirement issue that names the ID\nis closed as completed?) then (yes)
    if (the requirement changed after the last\ncompleted requirement issue closed?) then (yes)
      #FFEBEE:not filed (changed);
    else (no)
      #E8F5E9:done;
    endif
  else (no)
    #FFEBEE:not filed;
  endif
endif
stop
@enduml
