@startuml command-areas
skinparam shadowing false
left to right direction

rectangle "cumin-trace" as bin {
  rectangle "init <prefix> [<area>]" as init
  rectangle "check" as check
  rectangle "export" as export
  rectangle "version" as version
}

rectangle "TPL\ntemplates and skill" as tpl
rectangle "CHK\nformat check" as chk
rectangle "EXP\nstructured data" as exp
rectangle "CMD\ncommands" as cmd

init --> tpl : behavior
init --> chk : writes the check workflow
check --> chk : behavior
export --> exp : behavior
version --> cmd : behavior
bin --> cmd : list of commands,\nwrong arguments
@enduml
