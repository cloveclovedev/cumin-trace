@startuml site-build
left to right direction
skinparam shadowing false

package "product repository" {
  file "docs/ja/**/*.md\n(no frontmatter)" as md
  file "*.svg next to\nthe documents" as svg
  folder "site/\n(Astro + Starlight template)" as tpl
}

file "trace result\n(JSON)" as data
rectangle "Starlight build\n(adds the title, an anchor for each ID,\nlinks on ID references)" as build
folder "static site:\ndocuments + dashboard" as out

md --> build
svg --> build
tpl --> build
data --> build : dashboard only
build --> out
@enduml
