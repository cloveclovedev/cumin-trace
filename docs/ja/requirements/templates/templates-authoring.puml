@startuml templates-authoring
skinparam shadowing false

actor Maintainer
participant "Agent\n(with the skill)" as agent
participant "cumin-trace" as ct
database "requirement\ndocuments" as docs

Maintainer -> agent : say what is wanted
agent -> docs : read the format and the glossary
agent -> docs : write PC-TASK-005, the number after\nthe last one of area TASK\n(heading, text, verification)
agent -> ct : run the check
ct --> agent : no error\n(no duplicate, no gap)
agent --> Maintainer : draft on a branch
Maintainer -> docs : review and merge
@enduml
