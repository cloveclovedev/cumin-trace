@startuml site-packages
title Packages of the site
skinparam shadowing false
skinparam componentStyle rectangle

package "cumin-trace" {
  [internal/scaffold\nwrite each missing file (init)] as scaffold
  [internal/core\nread .cumin-trace.toml\n(adds the site table)] as core #LightYellow
  [templates/site\nembedded site template] as tsite #LightYellow
}

package "product repository" {
  file ".cumin-trace.toml\nprefix, requirements_dir,\nsite: docs_dir, base" as toml
  file "docs/ja/**/*.md\nSVG files next to the documents" as docs
  package "site/ (written by init)" #LightYellow {
    [astro.config.mjs\nbase, unified(), Starlight,\nhead script, processedDirs] as config
    [src/settings.mjs\nread .cumin-trace.toml (smol-toml)] as settings
    [src/content.config.mjs\nglob() loader + title\nfrom the first heading] as loader
    [src/remark-requirements.mjs\nanchors, sections, ID links,\n.md links, image paths] as remark
    [src/requirements.css\nrequirement section, ID badge] as css
    [scripts/check-site.mjs\ncheck the built HTML] as check
  }
}

folder "site/dist/\nstatic files" as dist

scaffold --> tsite : reads
scaffold --> config : writes site/
core --> toml : reads
config --> settings
config --> remark
config --> css
loader --> settings
remark --> settings
settings --> toml : reads
loader --> docs : reads
remark --> docs : reads requirement headings
config --> dist : astro build
check --> dist : reads
check --> docs : hash before and after

legend right
  yellow = designed in this document
  arrow = imports, reads, or writes
  no trace result and no cumin-trace command in the build
endlegend
@enduml
